# Base URL of the recognition-engine / SmartAccess backend
# (the FastAPI app in the Alternative_Identifier repo, src/api/main.py).
# Server-only — read in Server Actions (src/app/actions/auth.ts), never
# exposed to the client, so no NEXT_PUBLIC_ prefix.
API_BASE_URL=http://localhost:8000

# Signs/verifies the session cookie (src/lib/session.ts). Required
# in production — the app refuses to start without it there. Falls
# back to an insecure dev-only value when unset locally. Generate
# one with: openssl rand -base64 32
SESSION_SECRET=
